[
  {
    "description": "Support zh-CN locale code",
    "kind": "locale-allowlist",
    "required": true,
    "find": "=[\"en-US\",\"de-DE\",\"fr-FR\",\"ko-KR\",\"ja-JP\",\"es-419\",\"es-ES\",\"it-IT\",\"hi-IN\",\"pt-BR\",\"id-ID\"]",
    "replace": "=[\"en-US\",\"de-DE\",\"fr-FR\",\"ko-KR\",\"ja-JP\",\"es-419\",\"es-ES\",\"it-IT\",\"hi-IN\",\"pt-BR\",\"id-ID\",\"zh-CN\"]"
  },
  {
    "description": "Sidebar New task default message",
    "kind": "runtime-text",
    "required": false,
    "find": "defaultMessage:\"New task\"",
    "replace": "defaultMessage:\"新建任务\""
  },
  {
    "description": "Sidebar Projects default message",
    "kind": "runtime-text",
    "required": false,
    "find": "defaultMessage:\"Projects\"",
