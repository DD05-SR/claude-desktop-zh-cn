  },
  {
    "description": "Sidebar Projects object label",
    "kind": "runtime-text",
    "required": false,
    "find": "label:\"Projects\"",
    "replace": "label:\"项目\""
  },
  {
    "description": "Sidebar Scheduled object label",
    "kind": "runtime-text",
    "required": false,
    "find": "label:\"Scheduled\"",
    "replace": "label:\"定时任务\""
  },
  {
    "description": "Sidebar Customize object label",
    "kind": "runtime-text",
    "required": false,
    "find": "label:\"Customize\"",
    "replace": "label:\"自定义\""
  }
