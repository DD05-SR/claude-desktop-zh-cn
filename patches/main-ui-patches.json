  },
  {
    "description": "Sidebar Scheduled default message",
    "kind": "runtime-text",
    "required": false,
    "find": "defaultMessage:\"Scheduled\"",
    "replace": "defaultMessage:\"定时任务\""
  },
  {
    "description": "Sidebar Customize default message",
    "kind": "runtime-text",
    "required": false,
    "find": "defaultMessage:\"Customize\"",
